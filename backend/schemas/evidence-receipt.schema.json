{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-last-launch.github.io/fire-season/schemas/evidence-receipt.schema.json",
  "title": "Fire Season Evidence Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "artifact_id",
    "published_at",
    "region",
    "analysis",
    "sources",
    "exclusions",
    "calibration",
    "environment",
    "limitations",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^rcpt_[0-9a-f]{12}$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^art_[a-z0-9][a-z0-9_-]*_[0-9a-f]{12}$"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "region": {
      "$ref": "#/$defs/region"
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exclusion"
      }
    },
    "calibration": {
      "oneOf": [
        {
          "$ref": "#/$defs/calibration"
        },
        {
          "type": "null"
        }
      ]
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "revision", "name", "role", "geometry_ref", "geometry_sha256", "bounds_wsen"],
      "properties": {
        "region_id": {
          "type": "string",
          "pattern": "^region_[a-z0-9][a-z0-9_-]+_r[1-9][0-9]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": ["science_pilot", "local_impact_case", "transfer_test_region"]
        },
        "geometry_ref": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.).+\\.geojson$"
        },
        "geometry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bounds_wsen": {
          "$ref": "#/$defs/boundsWsen"
        }
      }
    },
    "boundsWsen": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_date",
        "end_date",
        "metric_id",
        "reference_product_id",
        "source_manifest_id",
        "source_manifest_sha256",
        "grid_version",
        "quality_policy_version",
        "minimum_monthly_support_fraction",
        "daily_coverage"
      ],
      "properties": {
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "metric_id": {
          "const": "detected_active_land_cell_days_per_1000_valid_land_cell_days"
        },
        "reference_product_id": {
          "type": "string",
          "minLength": 1
        },
        "source_manifest_id": {
          "type": "string",
          "pattern": "^src_[0-9a-f]{12}$"
        },
        "source_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "grid_version": {
          "type": "string",
          "minLength": 1
        },
        "quality_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "minimum_monthly_support_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "daily_coverage": {
          "$ref": "#/$defs/dailyCoverage"
        }
      }
    },
    "dailyCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_calendar_days",
        "myd14a1_observed_days",
        "vnp14a1_observed_days",
        "complete"
      ],
      "properties": {
        "expected_calendar_days": {
          "type": "integer",
          "minimum": 1
        },
        "myd14a1_observed_days": {
          "type": "integer",
          "minimum": 0
        },
        "vnp14a1_observed_days": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "const": true
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "short_name",
        "version",
        "platform",
        "stream",
        "nominal_resolution_m",
        "source_url",
        "product_guide_url",
        "provider_objects"
      ],
      "properties": {
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "short_name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "stream": {
          "enum": ["science_mask", "recent_context"]
        },
        "nominal_resolution_m": {
          "type": "integer",
          "minimum": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "product_guide_url": {
          "type": "string",
          "format": "uri"
        },
        "provider_objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/providerObject"
          }
        }
      }
    },
    "providerObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_object_id",
        "source_url",
        "observed_start",
        "observed_end",
        "retrieved_at",
        "retrieval_timestamp_status",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "provider_object_id": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "observed_start": {
          "type": "string",
          "format": "date-time"
        },
        "observed_end": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieval_timestamp_status": {
          "enum": ["recorded", "not_recorded_for_local_copy"]
        },
        "provider_checksum": {
          "type": ["string", "null"]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "reason", "cell_days"],
      "properties": {
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "enum": ["low_confidence_excluded", "cloud", "unknown", "unprocessed", "water_or_non_land", "outside_region"]
        },
        "cell_days": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "activityRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "type": "number", "minimum": 0, "maximum": 1000 },
        "maximum": { "type": "number", "minimum": 0, "maximum": 1000 }
      }
    },
    "calibrationDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_product_version",
        "reference_product_version",
        "quality_policy_version",
        "grid_version",
        "region_ids",
        "source_activity_range_per_1000",
        "comparable_activity_range_per_1000",
        "minimum_support_fraction"
      ],
      "properties": {
        "source_product_version": { "type": "string", "minLength": 1 },
        "reference_product_version": { "type": "string", "minLength": 1 },
        "quality_policy_version": { "type": "string", "minLength": 1 },
        "grid_version": { "type": "string", "minLength": 1 },
        "region_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^region_[a-z0-9][a-z0-9_-]+_r[1-9][0-9]*$" }
        },
        "source_activity_range_per_1000": { "$ref": "#/$defs/activityRange" },
        "comparable_activity_range_per_1000": { "$ref": "#/$defs/activityRange" },
        "minimum_support_fraction": { "type": "number", "minimum": 0.5, "maximum": 1 }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration_id",
        "status",
        "source_product_id",
        "reference_product_id",
        "training_manifest_sha256",
        "split_manifest_sha256",
        "model_sha256",
        "code_revision",
        "domain",
        "evaluation_ref",
        "evaluation"
      ],
      "properties": {
        "calibration_id": {
          "type": "string",
          "pattern": "^cal_[a-z0-9][a-z0-9_.-]+$"
        },
        "status": {
          "enum": ["released", "withdrawn"]
        },
        "source_product_id": {
          "type": "string",
          "minLength": 1
        },
        "reference_product_id": {
          "type": "string",
          "minLength": 1
        },
        "training_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "split_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "code_revision": {
          "type": "string",
          "minLength": 7
        },
        "domain": {
          "$ref": "#/$defs/calibrationDomain"
        },
        "evaluation_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\.\\.).+$"
        },
        "evaluation": {
          "$ref": "#/$defs/evaluation"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "training_seasons",
        "heldout_seasons",
        "positive_block_months",
        "identity_mae",
        "seasonal_baseline_mae",
        "candidate_mae",
        "mae_improvement_fraction",
        "regional_bias",
        "regional_bias_baseline",
        "regional_bias_tolerance",
        "peak_month_identifiable",
        "peak_month_error",
        "nominal_interval_level",
        "empirical_interval_coverage",
        "independent_test_block_months",
        "paired_support_fraction",
        "transfer_test_status",
        "transfer_test_region_id",
        "transfer_test_region_geometry_ref",
        "transfer_test_region_geometry_sha256",
        "transfer_test_region_bounds_wsen",
        "gate_results",
        "release_gate_status"
      ],
      "properties": {
        "training_seasons": {
          "type": "integer",
          "minimum": 0
        },
        "heldout_seasons": {
          "type": "integer",
          "minimum": 0
        },
        "positive_block_months": {
          "type": "integer",
          "minimum": 0
        },
        "identity_mae": {
          "type": "number",
          "minimum": 0
        },
        "seasonal_baseline_mae": {
          "type": "number",
          "minimum": 0
        },
        "candidate_mae": {
          "type": "number",
          "minimum": 0
        },
        "mae_improvement_fraction": {
          "type": "number"
        },
        "regional_bias": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "number"
          }
        },
        "regional_bias_baseline": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "number"
          }
        },
        "regional_bias_tolerance": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "peak_month_identifiable": {
          "type": "boolean"
        },
        "peak_month_error": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 11
        },
        "nominal_interval_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "empirical_interval_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "independent_test_block_months": {
          "type": "integer",
          "minimum": 1
        },
        "paired_support_fraction": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1
        },
        "transfer_test_status": {
          "enum": ["pass", "fail", "insufficient_support"]
        },
        "transfer_test_region_id": {
          "type": "string",
          "pattern": "^region_[a-z0-9][a-z0-9_-]+_r[1-9][0-9]*$"
        },
        "transfer_test_region_geometry_ref": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.).+\\.geojson$"
        },
        "transfer_test_region_geometry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "transfer_test_region_bounds_wsen": {
          "$ref": "#/$defs/boundsWsen"
        },
        "gate_results": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "training_and_holdout_support",
            "paired_support",
            "baseline_skill",
            "regional_bias",
            "peak_timing",
            "interval_coverage",
            "transfer_test",
            "declared_domain",
            "provenance_reproducibility"
          ],
          "properties": {
            "training_and_holdout_support": { "enum": ["pass", "fail", "insufficient_support"] },
            "paired_support": { "enum": ["pass", "fail", "insufficient_support"] },
            "baseline_skill": { "enum": ["pass", "fail", "insufficient_support"] },
            "regional_bias": { "enum": ["pass", "fail", "insufficient_support"] },
            "peak_timing": { "enum": ["pass", "fail", "insufficient_support"] },
            "interval_coverage": { "enum": ["pass", "fail", "insufficient_support"] },
            "transfer_test": { "enum": ["pass", "fail", "insufficient_support"] },
            "declared_domain": { "enum": ["pass", "fail", "insufficient_support"] },
            "provenance_reproducibility": { "enum": ["pass", "fail", "insufficient_support"] }
          }
        },
        "release_gate_status": {
          "enum": ["pass", "fail"]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "dependency_lock_sha256", "pipeline_revision", "operating_system"],
      "properties": {
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "dependency_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pipeline_revision": {
          "type": "string",
          "minLength": 7
        },
        "operating_system": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "size_bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.).+$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
