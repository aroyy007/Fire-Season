{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-last-launch.github.io/fire-season/schemas/release-manifest.schema.json",
  "title": "Fire Season Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "manifest_created_at", "files"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^art_[a-z0-9][a-z0-9_-]*_[0-9a-f]{12}$"
    },
    "manifest_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/file"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "path": {
                "const": "analysis.json"
              }
            },
            "required": ["path"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "path": {
                "const": "evidence-receipt.json"
              }
            },
            "required": ["path"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "size_bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!manifest\\.json$)(?!.*\\.\\.).+$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
